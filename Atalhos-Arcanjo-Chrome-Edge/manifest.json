{
  "manifest_version": 3,
  "name": "Atalhos Arcanjo: Expansor de Texto Médico & Snippets (100% Liberado)",
  "version": "2.0.0",
  "description": "Digite um atalho curto e expanda textos completos, condicionais, calculadoras médicas (IMC, ClCr, FIB-4), menus e datas. 100% em português, ilimitado e privado.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "clipboardRead",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Atalhos Arcanjo — Meus Atalhos e Prancheta Clínica"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "guard.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "template.js",
        "html.js",
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle",
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "page-main.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "world": "MAIN",
      "match_origin_as_fallback": true
    }
  ],
  "commands": {
    "open-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "MacCtrl+Shift+Space"
      },
      "description": "Buscar e inserir um atalho (Atalhos Arcanjo)"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
